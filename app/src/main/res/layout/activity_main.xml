<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:textColor="@color/muted"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/current"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif-light"
        android:textColor="@color/charging"
        android:textSize="72sp" />

    <TextView
        android:id="@+id/power"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:fontFamily="sans-serif-light"
        android:textColor="@color/text"
        android:textSize="40sp" />

    <TextView
        android:id="@+id/scale_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:background="?android:attr/selectableItemBackground"
        android:padding="6dp"
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:background="@drawable/card"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="8dp"
        android:paddingRight="20dp"
        android:paddingBottom="8dp">

        <LinearLayout style="@style/Row">
            <TextView style="@style/Label" android:text="@string/voltage" />
            <TextView android:id="@+id/voltage" style="@style/Value" />
        </LinearLayout>

        <LinearLayout style="@style/Row">
            <TextView style="@style/Label" android:text="@string/temperature" />
            <TextView android:id="@+id/temp" style="@style/Value" />
        </LinearLayout>

        <LinearLayout style="@style/Row">
            <TextView style="@style/Label" android:text="@string/level" />
            <TextView android:id="@+id/level" style="@style/Value" />
        </LinearLayout>

        <LinearLayout style="@style/Row">
            <TextView style="@style/Label" android:text="@string/eta" />
            <TextView android:id="@+id/eta" style="@style/Value" />
        </LinearLayout>
    </LinearLayout>

    <!-- Memória de cálculo da identificação do tipo de bateria (aberta ao tocar no tipo). -->
    <LinearLayout
        android:id="@+id/calc_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/card"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/calc_title"
            android:textColor="@color/text"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/calc_how"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <com.ranieri.cargabateria.RatioGauge
            android:id="@+id/calc_gauge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <ProgressBar
            android:id="@+id/calc_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progressTint="@color/charging" />

        <TextView
            android:id="@+id/calc_live"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/text"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/calc_comment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/calc_comment_hint"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="3"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/calc_close"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/calc_close"
                android:textColor="@color/muted" />

            <Button
                android:id="@+id/calc_report"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/calc_report"
                android:textColor="@color/charging" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/app_version"
        android:textColor="@color/muted"
        android:textSize="11sp" />
</LinearLayout>
</ScrollView>
