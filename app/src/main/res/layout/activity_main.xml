<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:textColor="@color/muted"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/current"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif-light"
        android:textColor="@color/charging"
        android:textSize="72sp" />

    <TextView
        android:id="@+id/power"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:fontFamily="sans-serif-light"
        android:textColor="@color/text"
        android:textSize="40sp" />

    <TextView
        android:id="@+id/scale_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:background="@drawable/card"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="8dp"
        android:paddingRight="20dp"
        android:paddingBottom="8dp">

        <LinearLayout style="@style/Row">
            <TextView style="@style/Label" android:text="@string/voltage" />
            <TextView android:id="@+id/voltage" style="@style/Value" />
        </LinearLayout>

        <LinearLayout style="@style/Row">
            <TextView style="@style/Label" android:text="@string/temperature" />
            <TextView android:id="@+id/temp" style="@style/Value" />
        </LinearLayout>

        <LinearLayout style="@style/Row">
            <TextView style="@style/Label" android:text="@string/level" />
            <TextView android:id="@+id/level" style="@style/Value" />
        </LinearLayout>

        <LinearLayout style="@style/Row">
            <TextView style="@style/Label" android:text="@string/eta" />
            <TextView android:id="@+id/eta" style="@style/Value" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:alpha="0.5"
        android:textColor="@color/muted"
        android:textSize="11sp" />
</LinearLayout>
